// ES: Genera una colección de puntos de entrenamiento para una entidad regional.
//     Realiza un muestreo aleatorio estratificado por clase y agrega a cada
//     punto el identificador "ECOZONA" de la entidad de origen.
// EN: Generates a collection of training points for one regional feature.
//     Performs random sampling stratified by class and adds the source
//     feature's "ECOZONA" identifier to each point.
var getTrainingSamples = function (feature) {

  // ES: Obtiene el identificador regional de la entidad procesada.
  // EN: Retrieves the regional identifier of the feature being processed.
  var regiao = feature.get('ECOZONA');
  //print(regiao)

  // ES: Asigna la misma cantidad solicitada de muestras a cada clase.
  //     Estas variables permiten definir cantidades diferentes por clase
  //     si se modifican en una versión posterior.
  // EN: Assigns the same requested sample count to each class.
  //     These variables allow different counts per class to be defined
  //     if modified in a later version.
  var num_train_02 = nSamples
  var num_train_03 = nSamples
  var num_train_04 = nSamples
  var num_train_09 = nSamples
  var num_train_11 = nSamples
  var num_train_12 = nSamples
  var num_train_15 = nSamples
  var num_train_18 = nSamples
  var num_train_21 = nSamples
  var num_train_22 = nSamples
  var num_train_33 = nSamples
  var num_train_79 = nSamples
  var num_train_80 = nSamples
  var num_train_83 = nSamples
  
  
  // ES: Extrae la geometría de la entidad regional.
  // EN: Extracts the regional feature's geometry.
  var clippedGrid = ee.Feature(feature).geometry()

  // ES: Recorta el mapa de referencia al ámbito de la entidad regional.
  // EN: Clips the reference map to the regional feature's extent.
  var referenceMap =  dirsamples.clip(clippedGrid);
  //Map.addLayer(referenceMap,vis)

  // ES: Extrae puntos aleatorios por clase a una escala nominal de 30 m.
  //     - classBand: banda que define los estratos del muestreo.
  //     - numPoints: 0 establece cero puntos para clases no enumeradas.
  //     - region: limita el muestreo a la geometría de la entidad.
  //     - seed: fija la semilla aleatoria para reproducibilidad con los
  //       mismos datos y parámetros.
  //     - geometries: true conserva la geometría de cada punto.
  //     - classValues y classPoints: relacionan cada código con su cantidad.
  //     Por defecto, se omiten píxeles con alguna banda enmascarada.
  // EN: Extracts random points per class at a nominal scale of 30 m.
  //     - classBand: band defining the sampling strata.
  //     - numPoints: 0 sets zero points for classes not listed.
  //     - region: restricts sampling to the feature's geometry.
  //     - seed: fixes the random seed for reproducibility with the
  //       same data and parameters.
  //     - geometries: true retains each point's geometry.
  //     - classValues and classPoints: pair each code with its sample count.
  //     By default, pixels with any masked band are skipped.
  var training = referenceMap.stratifiedSample({scale:30, classBand: 'reference', numPoints: 0, region: feature.geometry(), seed: 1, geometries: true,
           classValues: [2, 3, 4, 9, 11, 12, 15, 18, 21, 22, 33,79,80,83], 
           classPoints: [num_train_02,
                         num_train_03,
                         num_train_04,
                         num_train_09,
                         num_train_11,
                         num_train_12,
                         num_train_15,
                         num_train_18,
                         num_train_21,
                         num_train_22,
                         num_train_33,
                         num_train_79,
                         num_train_80,
                         num_train_83,]
  });

  // ES: Recorre los puntos obtenidos y agrega la propiedad regional "ECOZONA",
  //     conservando las propiedades extraídas de la imagen y la geometría.
  // EN: Iterates over the sampled points and adds the regional "ECOZONA"
  //     property, retaining the image-derived properties and geometry.
  training = training.map(function(feat) {return feat.set({'ECOZONA': regiao})});

  // ES: Devuelve la colección de puntos de esta entidad regional.
  // EN: Returns the point collection for this regional feature.
  return training;
 };

// ES: Ejecuta la función para cada entidad regional y reúne las colecciones
//     resultantes en una única colección de puntos mediante flatten().
//     Si las regiones se superponen, sus muestreos pueden compartir áreas;
//     flatten() no elimina puntos duplicados ni impone separación espacial.
// EN: Runs the function for each regional feature and combines the resulting
//     collections into a single point collection using flatten().
//     If regions overlap, their samples may share areas;
//     flatten() does not remove duplicate points or enforce spatial separation.
var mySamples = regioesCollection.map(getTrainingSamples).flatten();

// ES: Agrega los puntos de entrenamiento al mapa.
// EN: Adds the training points to the map.
Map.addLayer(mySamples)

