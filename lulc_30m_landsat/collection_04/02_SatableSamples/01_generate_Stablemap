//     criterion is implemented directly in the function.
//     Class 29 is in this dictionary but not in the preceding remap.
//     Class 4 is in the remap but has no output mask here.
var classFrequency = { "2": freq_lim, "3": freq_lim, "9": freq_lim, "11": freq_lim, "12": freq_lim, "15": 3 ,"18": 4, 
                      "21": freq_lim, "22": freq_lim, "29": freq_lim, "33": freq_lim,"79": freq_lim, "80": freq_lim, "83": freq_lim,}

