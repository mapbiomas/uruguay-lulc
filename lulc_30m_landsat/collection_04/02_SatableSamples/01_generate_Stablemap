// ES: Recorre las claves del diccionario y genera una imagen por clase
//     llamando a getFrenquencyMask con la misma colección temporal.
// EN: Iterates over dictionary keys and generates one image per class
//     by calling getFrenquencyMask with the same temporal collection.
var frequencyMasks = Object.keys(classFrequency).map(function(classId) {
    return getFrenquencyMask(collection, classId);
});

// ES: Convierte el arreglo de máscaras por clase en una colección de imágenes.
// EN: Converts the array of per-class masks into an image collection.
frequencyMasks = ee.ImageCollection.fromImages(frequencyMasks);

// ES: Combina las máscaras tomando el primer valor no enmascarado por píxel
//     y recorta el resultado al ámbito "pampa".
//     "pampa" debe existir como importación o variable definida fuera de este código.
// EN: Combines masks by taking the first unmasked value per pixel
//     and clips the result to "pampa".
//     "pampa" must exist as an import or a variable defined outside this code.
var referenceMap = frequencyMasks.reduce(ee.Reducer.firstNonNull()).clip(pampa);

// ES: Excluye el código 27 y renombra la banda como "reference".
// EN: Excludes code 27 and renames the band to "reference".
referenceMap = referenceMap.mask(referenceMap.neq(27)).rename("reference");

