// ES: Devuelve los valores únicos de un arreglo JavaScript, conservando
//     el orden de su primera aparición. No se invoca en este script.
// EN: Returns the unique values of a JavaScript array, preserving
//     their first-occurrence order. It is not called in this script.
var unique = function(arr) {
    var u = {},
        a = [];
    for (var i = 0, l = arr.length; i < l; ++i) {
        if (!u.hasOwnProperty(arr[i])) {
            a.push(arr[i]);
            u[arr[i]] = 1;
        }
    }
    return a;
};

