/**
 * REFERENCE MAP
 */

// ES: Genera una imagen de referencia para una clase.
//     Para la clase 15 exige al menos una secuencia de tres años consecutivos
//     y aplica la exclusión de bajos. Para las demás clases utiliza el número
//     total de ocurrencias, sin exigir que sean consecutivas.
//     La salida contiene el código de clase; no contiene el conteo de años.
// EN: Generates a reference image for one class.
//     Class 15 requires at least one sequence of three consecutive years
//     and applies the lowland exclusion. Other classes use the total number
//     of occurrences, without requiring consecutive years.
//     The output contains the class code, not the year count.
var getFrenquencyMask = function(collection, classId) {

  // ES: Convierte el identificador de clase de texto a entero decimal.
  // EN: Converts the class identifier from a string to a decimal integer.
  var classIdInt = parseInt(classId, 10);

  // ES: Para cada imagen anual, devuelve 1 donde aparece la clase y 0 donde
  //     aparece otra clase válida. Los píxeles enmascarados siguen enmascarados.
  // EN: For each annual image, returns 1 where the class occurs and 0 where
  //     another valid class occurs. Masked pixels remain masked.
  var maskCollection = collection.map(function(image) {
    return image.eq(classIdInt);
  });

  // ES: Aplica el criterio especial de persistencia para la clase 15.
  // EN: Applies the special persistence criterion for class 15.
  if (classIdInt === 15) {

  // ES: Convierte la colección en lista para acceder a años por su posición.
  // EN: Converts the collection to a list to access years by their position.
  var list = maskCollection.toList(maskCollection.size());

  // ES: Inicializa la imagen que acumulará las secuencias válidas.
  // EN: Initializes the image that will accumulate valid sequences.
  var consecutiveMask = ee.Image(0);

  // ES: Recorre todas las ventanas de tres posiciones consecutivas.
  //     Su interpretación como años consecutivos depende del orden de "anos".
  // EN: Iterates over all windows of three consecutive positions.
  //     Their interpretation as consecutive years depends on the order of "anos".
  for (var i = 0; i < (anos.length - 2); i++) {
    var img1 = ee.Image(list.get(i));
    var img2 = ee.Image(list.get(i + 1));
    var img3 = ee.Image(list.get(i + 2));

    // ES: Identifica la presencia de la clase en las tres imágenes de la ventana.
    // EN: Identifies class presence in all three images of the window.
    var triple = img1.and(img2).and(img3);

    // ES: Acumula las ventanas mediante OR. Las operaciones mantienen las
    //     máscaras de entrada; no convierten datos faltantes en ausencia.
    // EN: Accumulates windows using OR. Operations retain input masks;
    //     missing data are not converted into absence.
    consecutiveMask = consecutiveMask.or(triple);
  }

  // ES: Conserva zonas con valor cero o sin datos en "bajos".
  //     Los valores distintos de cero quedan excluidos.
  // EN: Retains areas with zero values or missing data in "bajos".
  //     Nonzero values are excluded.
  // Excluir zonas dentro del raster: usamos bajos igual a 0 o nulo
  var fueraDeBajos = bajos.unmask(0).eq(0); // Incluye nodata

  // ES: Aplica la máscara de exclusión a las secuencias de clase 15.
  // EN: Applies the exclusion mask to class 15 sequences.
  var maskedConsecutive = consecutiveMask.updateMask(fueraDeBajos);

  // ES: Sustituye la presencia por el código de clase y convierte a byte.
  // EN: Replaces presence with the class code and converts to byte.
  var result = maskedConsecutive.multiply(classIdInt).toByte();

  // ES: Enmascara los ceros, nombra la banda y agrega el identificador de clase.
  // EN: Masks zeros, names the band, and adds the class identifier.
  return result.mask(result.neq(0)).rename('frequency').set('class_id', classId);
}

   else {

    // ES: Suma las presencias anuales por píxel sobre las observaciones válidas.
    // EN: Sums annual class occurrences per pixel over valid observations.
    var frequency = maskCollection.reduce(ee.Reducer.sum());

    // ES: Selecciona los píxeles que alcanzan el umbral de la clase y les
    //     asigna su código, almacenado como entero de 8 bits sin signo.
    // EN: Selects pixels meeting the class threshold and assigns their
    //     class code, stored as an unsigned 8-bit integer.
    var frequencyMask = frequency.gte(classFrequency[classId])
      .multiply(classIdInt)
      .toByte();

    // ES: Enmascara los píxeles que no cumplen el criterio y normaliza
    //     el nombre de banda y la propiedad de clase.
    // EN: Masks pixels that do not meet the criterion and standardizes
    //     the band name and class property.
    return frequencyMask.mask(frequencyMask.neq(0)).rename('frequency').set('class_id', classId);
  }
};
