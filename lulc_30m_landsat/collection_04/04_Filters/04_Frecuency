 //************************************************************
//************************************************************
//************************************************************
//**********************************************
// FILTRO DE FRECUENCIA FORESTACIÓN / AGRICULTURA
//
// Corrige interrupciones temporales dentro de
// zonas predominantemente forestadas.
//
// CLASES:
//
// 3  = bosque
// 9  = forestación
// 12 = pastizal
// 15 = pastura
// 18 = agricultura
// 22 = área no vegetada
//
// IMPORTANTE:
//
// 12 NO participa en "forestación joven".
//
// 12 SÍ puede convertirse a 9 cuando forma parte
// de una ventana de interrupción/cosecha dentro
// de una forestación establecida.
//
// Ejemplo:
//
// 9 9 9 | 18 12 12 | 9 9 9
//
// pasa a:
//
// 9 9 9 |  9  9  9 | 9 9 9
//
//**********************************************

// ES: Filtro de forestación activo: evalúa patrones anuales sobre imgBase fija, sin realimentación dentro de este bloque.
// EN: Active plantation filter: evaluates annual patterns against fixed imgBase, without feedback within this block.
if (aplicar.freqForest_agr) {

  var imgBase = image_in;


  //==========================================================
  // FUNCIONES AUXILIARES
  //==========================================================

// ES: Devuelve la banda del año solicitado de la imagen base de este filtro.
// EN: Returns the requested annual band from this filter’s base image.
  function banda(año) {
    return imgBase.select("classification_" + año);
  }


// ES: Máscara de presencia de clase 9 en el año.
// EN: Mask of class 9 presence in the year.
  function forest(año) {
    return banda(año).eq(9);
  }


  // Candidatos para FORESTACIÓN JOVEN.
  //
  // IMPORTANTE:
  // NO incluye clase 12.
  //
  function candidatoCambio(año) {

    var img = banda(año);
// ES: Candidatos a adelantar forestación: 3, 15, 18 y 22; excluye 12. Es una regla inferida, no evidencia independiente de plantación.
// EN: Candidates for backdating plantations: 3, 15, 18 and 22; excludes 12. This is an inferred rule, not independent planting evidence.

    return img.eq(3)
      .or(img.eq(15))
      .or(img.eq(18))
      .or(img.eq(22));
  }


  // Candidatos para INTERRUPCIONES / COSECHA.
  //
  // Aquí SÍ incluimos clase 12.
  //
  function candidatoInterrupcion(año) {

    var img = banda(año);
// ES: Candidatos a interrupción: incluye también 12.
// EN: Interruption candidates: also includes 12.

    return img.eq(3)
      .or(img.eq(12))
      .or(img.eq(15))
      .or(img.eq(18))
      .or(img.eq(22));
  }


  // Frecuencia reciente de forestación
// ES: Exige más de 50% de clase 9 en 2017–2025: al menos cinco de nueve años si todas las bandas son válidas.
// EN: Requires over 50% class 9 in 2017–2025: at least five of nine years if all bands are valid.
  var freqForest = forFreq4.gt(50);


  // Lista de años
  var años = [];

  for (var y = 1985; y <= 2025; y++) {
    años.push(y);
  }


  var bandasSalida = [];


  //==========================================================
  // PROCESAMIENTO AÑO POR AÑO
  //==========================================================

  años.forEach(function(año) {

    var actual = banda(año);

    var candCambio =
// ES: Acumula con OR las condiciones que autorizan reemplazar el año actual por 9.
// EN: Combines with OR the conditions authorizing replacement of the current year with 9.
      candidatoCambio(año);

    var candInterrupcion =
      candidatoInterrupcion(año);

    var activar = ee.Image(0);


    //========================================================
    // 1. FORESTACIÓN JOVEN - 1 AÑO
    //
    // Ejemplo:
    //
    // 18 | 9 | 9 | 9
    //
    // 18 -> 9
    //
    // IMPORTANTE:
    // 12 NO puede activar esta condición.
    //========================================================

    if (año <= 2022) {

      var joven1 =
        candCambio
          .and(forest(año + 1))
// ES: Regla joven1: el candidato debe estar seguido por tres años con clase 9.
// EN: joven1 rule: the candidate must be followed by three years of class 9.
          .and(forest(año + 2))
          .and(forest(año + 3));

      activar = activar.or(joven1);
    }


    //========================================================
    // 2. FORESTACIÓN JOVEN - 2 AÑOS
    //
    // Ejemplo:
    //
    // 18 | 18 | 9 | 9
    //
    // 18 18 -> 9 9
    //
    // Nuevamente:
    // 12 NO participa.
    //========================================================

    if (año <= 2021) {

      var joven2 =
        candCambio
          .and(candidatoCambio(año + 1))
          .and(forest(año + 2))
          .and(forest(año + 3))
          .and(forest(año + 4));

      activar = activar.or(joven2);
// ES: Regla joven2: dos candidatos seguidos por tres años de clase 9; el dibujo original muestra solo dos.
// EN: joven2 rule: two candidates followed by three years of class 9; the original sketch shows only two.
    }


    //========================================================
    // 3. VENTANA HISTÓRICA DE 2 AÑOS
    //
    // Detectamos:
    //
    // 9 9 9 | X X | 9 9 9 9
    //
    // X puede ser:
    // 3, 12, 15, 18 o 22
    //
    // La ventana se detecta completa.
    //
    // Esto permite:
    //
    // 9 9 9 | 18 12 | 9 9 9 9
    //
    // convertir AMBOS:
    //
    // 9 9 9 |  9  9 | 9 9 9 9
    //========================================================


    // -------------------------------------------------------
    // 3a. Actual = PRIMER año de la ventana
    //
    // 9 9 9 | X X | 9 9 9 9
    //          ^
    //        actual
    // -------------------------------------------------------

    if (año >= 1988 && año <= 2021) {

      var int2_inicio =
        candidatoInterrupcion(año)
          .and(candidatoInterrupcion(año + 1))

          .and(forest(año - 1))
          .and(forest(año - 2))
          .and(forest(año - 3))

          .and(forest(año + 2))
          .and(forest(año + 3))
          .and(forest(año + 4));

// ES: Ventana histórica de dos candidatos, con tres años de clase 9 a cada lado; se evalúan ambas posiciones.
// EN: Historical window of two candidates, with three class-9 years on each side; both positions are evaluated.
      activar = activar.or(int2_inicio);
    }


    // -------------------------------------------------------
    // 3b. Actual = SEGUNDO año de la ventana
    //
    // 9 9 9 | X X | 9 9 9 9
    //            ^
    //          actual
    //
    // La ventana comenzó en año-1.
    // -------------------------------------------------------

    if (año >= 1989 && año <= 2022) {

      var int2_fin =
        candidatoInterrupcion(año - 1)
          .and(candidatoInterrupcion(año))

          .and(forest(año - 2))
          .and(forest(año - 3))
          .and(forest(año - 4))

          .and(forest(año + 1))
          .and(forest(año + 2))
          .and(forest(año + 3));

      activar = activar.or(int2_fin);
    }


    //========================================================
    // 4. VENTANA HISTÓRICA DE 3 AÑOS
    //
    // Detectamos:
    //
    // 9 9 9 | X X X | 9 9 9
    //
    // donde X puede incluir 12.
    //
    // Ejemplo fundamental:
    //
    // 9 9 9 | 18 12 12 | 9 9 9
    //
    // Los TRES pasan a 9.
    //========================================================


    // -------------------------------------------------------
    // 4a. Actual = PRIMER año
    //
    // 9 9 9 | X X X | 9 9 9
    //          ^
    // -------------------------------------------------------

    if (año >= 1988 && año <= 2020) {

      var int3_inicio =
        candidatoInterrupcion(año)
          .and(candidatoInterrupcion(año + 1))
          .and(candidatoInterrupcion(año + 2))

          .and(forest(año - 1))
          .and(forest(año - 2))
          .and(forest(año - 3))

          .and(forest(año + 3))
          .and(forest(año + 4))
          .and(forest(año + 5));

      activar = activar.or(int3_inicio);
    }

// ES: Ventana histórica de tres candidatos, con tres años de clase 9 a cada lado; se evalúan las tres posiciones.
// EN: Historical window of three candidates, with three class-9 years on each side; all three positions are evaluated.

    // -------------------------------------------------------
    // 4b. Actual = SEGUNDO año
    //
    // 9 9 9 | X X X | 9 9 9
    //            ^
    //
    // La ventana comenzó en año-1.
    // -------------------------------------------------------

    if (año >= 1989 && año <= 2021) {

      var int3_medio =
        candidatoInterrupcion(año - 1)
          .and(candidatoInterrupcion(año))
          .and(candidatoInterrupcion(año + 1))

          .and(forest(año - 2))
          .and(forest(año - 3))
          .and(forest(año - 4))

          .and(forest(año + 2))
          .and(forest(año + 3))
          .and(forest(año + 4));

      activar = activar.or(int3_medio);
    }


    // -------------------------------------------------------
    // 4c. Actual = TERCER año
    //
    // 9 9 9 | X X X | 9 9 9
    //              ^
    //
    // La ventana comenzó en año-2.
    // -------------------------------------------------------

    if (año >= 1990 && año <= 2022) {

      var int3_fin =
        candidatoInterrupcion(año - 2)
          .and(candidatoInterrupcion(año - 1))
          .and(candidatoInterrupcion(año))

          .and(forest(año - 3))
          .and(forest(año - 4))
          .and(forest(año - 5))

          .and(forest(año + 1))
          .and(forest(año + 2))
          .and(forest(año + 3));

      activar = activar.or(int3_fin);
    }


    //========================================================
    // 5. COSECHA / INTERRUPCIÓN RECIENTE
    //
    // Desde 2016.
    //
    // También se corrige para que una ventana de 2 o 3 años
    // se detecte completa.
    //
    // Aquí usamos freqForest.
    //========================================================


    if (año >= 2016) {
// ES: Desde 2016, las reglas recientes exigen tres años previos de forestación y frecuencia reciente alta, sin exigir recuperación posterior. Pueden ocultar conversiones reales.
// EN: From 2016, recent rules require three preceding plantation years and high recent frequency, without requiring later recovery. They may hide real conversions.


      //======================================================
      // 5.1 UNA SOLA INTERRUPCIÓN
      //
      // 9 9 9 | X | ...
      //======================================================

      var cosecha1 =
        candInterrupcion
          .and(forest(año - 1))
          .and(forest(año - 2))
          .and(forest(año - 3))
          .and(freqForest);

      activar = activar.or(cosecha1);


      //======================================================
      // 5.2 VENTANA RECIENTE DE 2 AÑOS
      //
      // 9 9 9 | X X
      //
      // Detectamos ambos años por separado, pero siempre
      // comprobando la ventana completa.
      //======================================================


      // PRIMER año
      if (año <= 2024) {

        var cosecha2_inicio =
          candInterrupcion
            .and(candidatoInterrupcion(año + 1))

            .and(forest(año - 1))
            .and(forest(año - 2))
            .and(forest(año - 3))

            .and(freqForest);

        activar = activar.or(cosecha2_inicio);
      }


      // SEGUNDO año
      if (año >= 2017) {

        var cosecha2_fin =
          candidatoInterrupcion(año - 1)
            .and(candInterrupcion)

            .and(forest(año - 2))
            .and(forest(año - 3))
            .and(forest(año - 4))

            .and(freqForest);

        activar = activar.or(cosecha2_fin);
      }


      //======================================================
      // 5.3 VENTANA RECIENTE DE 3 AÑOS
      //
      // 9 9 9 | X X X
      //
      // X puede ser:
      // 18 12 12
      // 12 18 12
      // 12 12 18
      // etc.
      //======================================================


      // PRIMER año
      if (año <= 2023) {

        var cosecha3_inicio =
          candInterrupcion
            .and(candidatoInterrupcion(año + 1))
            .and(candidatoInterrupcion(año + 2))

            .and(forest(año - 1))
            .and(forest(año - 2))
            .and(forest(año - 3))

            .and(freqForest);

        activar = activar.or(cosecha3_inicio);
      }


      // SEGUNDO año
      if (año >= 2017 && año <= 2024) {

        var cosecha3_medio =
          candidatoInterrupcion(año - 1)
            .and(candInterrupcion)
            .and(candidatoInterrupcion(año + 1))

            .and(forest(año - 2))
            .and(forest(año - 3))
            .and(forest(año - 4))

            .and(freqForest);

        activar = activar.or(cosecha3_medio);
      }


      // TERCER año
      if (año >= 2018) {

        var cosecha3_fin =
          candidatoInterrupcion(año - 2)
            .and(candidatoInterrupcion(año - 1))
            .and(candInterrupcion)

            .and(forest(año - 3))
            .and(forest(año - 4))
            .and(forest(año - 5))

            .and(freqForest);

        activar = activar.or(cosecha3_fin);
      }
    }


    //========================================================
    // 6. SEGURIDAD
    //
    // Solo permitimos cambiar a 9 las clases que definimos
    // como candidatas a interrupción.
    //
    // Esto incluye 12.
    //
    // No afecta a la lógica de forestación joven porque
    // allí 12 nunca entra en activar.
    //========================================================

// ES: Restringe el reemplazo final a las clases candidatas y conserva los restantes valores.
// EN: Restricts final replacement to candidate classes and preserves other values.
    activar =
      activar.and(candidatoInterrupcion(año));


    //========================================================
    // 7. REEMPLAZAR POR 9
    //========================================================

    var salida =
      actual
        .where(activar, 9)
        .rename("classification_" + año);


    bandasSalida.push(salida);

  });


  //==========================================================
  // 8. RECONSTRUIR IMAGEN
  //==========================================================

