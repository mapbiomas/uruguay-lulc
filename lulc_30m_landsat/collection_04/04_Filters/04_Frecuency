    return windowImg.reduce(ee.Reducer.mode());
  }

  // ---------- Función para calcular moda extendida en bordes
  function windowModeBorde(img, year) {
    var windowSize = 5;
    var half = Math.floor(windowSize / 2);
    var minYear = Math.max(startYear, year - half);
    var maxYear = Math.min(endYear, year + half);

    // extender la ventana para asegurar 5 bandas
    if (maxYear - minYear + 1 < windowSize) {
      if (minYear == startYear) {
        maxYear = Math.min(endYear, minYear + windowSize - 1);
      } else if (maxYear == endYear) {
        minYear = Math.max(startYear, maxYear - windowSize + 1);
      }
    }

    var windowBands = [];
    for (var yy = minYear; yy <= maxYear; yy++) {
      windowBands.push('classification_' + yy);
    }
// ES: Procesa años interiores a partir de la misma imagen de entrada; conserva primero y último para el tratamiento posterior.
// EN: Processes interior years against the same input image; retains first and last for subsequent treatment.
    var windowImg = img.select(windowBands);
    return windowImg.reduce(ee.Reducer.mode());
  }

  // ---------- Función para reemplazar clases aisladas interiores
  function replaceIsolatedInterior(img) {
    var out = img.select('classification_' + startYear); // primera intacta

    for (var y = startYear + 1; y <= endYear - 1; y++) {
      var mid = img.select('classification_' + y);
      var prev = img.select('classification_' + (y - 1));
      var next = img.select('classification_' + (y + 1));

      // máscaras para 12 y 15 aislados
      var masks = ee.List(clasesObjetivo).map(function(cl) {
        cl = ee.Number(cl);
        return mid.eq(cl).and(prev.neq(cl)).and(next.neq(cl));
      });

      var mask = ee.Image(masks.get(0));
      for (var i = 1; i < clasesObjetivo.length; i++) {
        mask = mask.or(ee.Image(masks.get(i)));
      }

      // elegir si usa ventana normal o extendida
      var mid_new;
      if (y === startYear + 1 || y === endYear - 1) {
        // casos 1986 y 2023
        mid_new = mid.where(mask, windowModeBorde(img, y))
                     .rename('classification_' + y);
      } else {
        mid_new = mid.where(mask, windowMode(img, y))
                     .rename('classification_' + y);
      }

      out = out.addBands(mid_new);
    }

    out = out.addBands(img.select('classification_' + endYear)); // última intacta
// ES: Extremo inicial: clases 12 y 15. Extremo final: solo clase 12; los años reales usados son 2023–2025.
// EN: Start edge: classes 12 and 15. End edge: class 12 only; actual years used are 2023–2025.
    return out;
  }

  // ---------- Función para reemplazar solo extremos absolutos (1985 y 2024)
  function replaceEdges(img) {
    // 1985
    var b85 = img.select('classification_1985');
    var b86 = img.select('classification_1986');
    var b87 = img.select('classification_1987');

    var masksStart = ee.List(clasesObjetivo).map(function(cl) {
      cl = ee.Number(cl);
      return b85.eq(cl).and(b86.neq(cl)).and(b87.neq(cl));
    });

    var maskStart = ee.Image(masksStart.get(0));
    for (var i = 1; i < clasesObjetivo.length; i++) {
      maskStart = maskStart.or(ee.Image(masksStart.get(i)));
    }

    var b85_new = b85.where(maskStart, windowModeBorde(img, startYear))
                     .rename('classification_1985');

    // 2025
    var b24 = img.select('classification_2025');
    var b23 = img.select('classification_2024');
    var b22 = img.select('classification_2023');

    var masksEnd = ee.List([12]).map(function(cl) {
      cl = ee.Number(cl);
      return b24.eq(cl).and(b23.neq(cl)).and(b22.neq(cl));
// ES: ERROR CONSERVADO: b24 contiene 2025, pero b24_new se renombra classification_2024. Sobrescribe 2024 y deja 2025 sin esta corrección.
// EN: PRESERVED ERROR: b24 contains 2025, but b24_new is renamed classification_2024. This overwrites 2024 and leaves 2025 without this correction.
    });

    var maskEnd = ee.Image(masksEnd.get(0));
    

    var b24_new = b24.where(maskEnd, windowModeBorde(img, endYear))
                     .rename('classification_2024');

    img = img.addBands(b85_new, null, true)
             .addBands(b24_new, null, true);
    return img;
  }

  // ---------- Aplicar cambios
  fixed = replaceIsolatedInterior(fixed);
  fixed = replaceEdges(fixed);

  // ---------- Resultado final
  image_in = fixed.clip(limite);
