    var msk = ee.Image(stack.select([b]))
    msk = msk.eq(12).or(msk.eq(18)).or(msk.eq(15)) // 
    return ee.Image(stack.select([b])).updateMask(msk).rename("B").toInt16()
  })
  return ee.ImageCollection.fromImages(lst).mode()

}

