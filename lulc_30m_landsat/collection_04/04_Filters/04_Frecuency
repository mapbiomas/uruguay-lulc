// ES: Construye una máscara anual que acepta cualquiera de los códigos de la lista.
// EN: Builds an annual mask accepting any code in the list.
var get_mask = function(año, img, clases){
    var msk = ee.Image(0)
    clases.forEach(function(c){
      msk =   msk.or(img.select("classification_" + año).eq(c))
      })
    return msk
}

// ES: Calcula la moda temporal restringida a 11, 18 y 15; excluye las demás clases.
// EN: Computes temporal mode restricted to 11, 18 and 15; excludes other classes.
var moda_agr_umi = function(stack){
  var lst = stack.bandNames().map(function(b){
    var msk = ee.Image(stack.select([b]))
    msk = msk.eq(11).or(msk.eq(18)).or(msk.eq(15)) // 
    return ee.Image(stack.select([b])).updateMask(msk).rename("B").toInt16()
  })
  return ee.ImageCollection.fromImages(lst).mode()
}
// ES: Calcula la moda temporal restringida a 12, 18 y 15.
// EN: Computes temporal mode restricted to 12, 18 and 15.
  var moda_ag_pz = function(stack){
